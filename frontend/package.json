{
  "name": "experience-ledger-frontend",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx tests/api-smoke.ts",
    "format": "prettier --write src tests vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
